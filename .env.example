# Application database. The app connects as a role WITHOUT the bypassrls
# attribute so row-level security is actually enforced.
DATABASE_URL=postgres://crm_app:crm_app@localhost:5432/crm

# Migrations and tests run as the owner role, which may create policies.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/crm

# Managed Postgres only. Put the provider's CA certificate here so the
# connection is verified as well as encrypted; DATABASE_SSL_NO_VERIFY=1 skips
# verification instead, which is weaker. Neither is needed locally.
DATABASE_CA_CERT=
DATABASE_SSL_NO_VERIFY=

# 32-byte key, base64. Encrypts OAuth tokens at rest.
ENCRYPTION_KEY=

# The agent. Config editing is the only place the model runs.
#
# Pick one provider and set its key. AGENT_PROVIDER decides which runs; leave it
# blank and the first key present wins. There is no fallback between providers:
# if the configured one fails, the turn fails and says so.
#
#   anthropic   ANTHROPIC_API_KEY   + AGENT_MODEL       (default claude-opus-5)
#   gemini      GEMINI_API_KEY      + GEMINI_MODEL      (default gemini-3.7-flash)
#   openrouter  OPENROUTER_API_KEY  + OPENROUTER_MODEL  (default z-ai/glm-5.2:free)
#
# An OpenRouter model must support tool calling. Its :free variants cost nothing
# but share an upstream pool, so they can be rate-limited at busy times.
AGENT_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Per-request timeout in milliseconds. A whole-CRM build is a dozen tool rounds.
AGENT_TIMEOUT_MS=120000

# Set to 1 to disable the per-tenant monthly token budget check.
# Usage is still metered in agent_turns, just never blocked.
# A monthly_token_limit of 0 in token_budgets also means unlimited.
AGENT_BUDGET_DISABLED=

# Where OAuth comes back to. Every connector returns to
# {APP_URL}/api/connectors/{provider}/callback, which is the redirect URI to
# register with each provider.
APP_URL=http://localhost:3000

# Connectors. Each provider needs an OAuth *client id and secret* — an API key
# or a personal access token is a different thing and will not work. A provider
# with no credentials is shown as unavailable rather than offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Scheduled work (Vercel cron) authenticates with this shared secret.
# Without it /api/jobs/drain and /api/jobs/sweep refuse scheduler requests,
# and delayed automation steps never fire.
CRON_SECRET=
